<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>BetterOutlookReminder</RootNamespace>
    <AssemblyName>BetterOutlookReminder</AssemblyName>
    <StartupObject>BetterOutlookReminder.App</StartupObject>
    <ApplicationIcon>clock_green.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AssemblyTitle>BetterOutlookReminder</AssemblyTitle>
    <Product>BetterOutlookReminder</Product>
    <Company></Company>
    <Description></Description>
    <Copyright>Copyright ©  2014</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- Keep output at bin\Debug\ rather than bin\Debug\net472\. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Run 64 bit so the broker's native msalruntime resolves predictably. -->
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies for .NET Framework, so no targeting pack install is needed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loose resources, not compiled XAML pages. -->
    <Page Remove="Icon.xaml" />
    <Resource Include="Icon.xaml" />
    <Resource Include="clock_green.ico" />
    <Resource Include="clock_red.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.0.8" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" Version="1.3.3" />
    <PackageReference Include="Microsoft.Exchange.WebServices" Version="2.2.0" />
    <PackageReference Include="Microsoft.Graph" Version="3.29.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.66.2" />
    <PackageReference Include="WpfScreenHelper" Version="0.3.0" />
  </ItemGroup>

</Project>
